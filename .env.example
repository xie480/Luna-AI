# Luna AI 环境变量示例
# 复制此文件为 .env 并填入实际值
# 注意：请勿在此文件中填写真实的敏感信息，仅作为配置示例

# ============================================================
# 基础配置
# ============================================================
# LLM 调用频率限制配置
LLM_CALL_INTERVAL_SECONDS=0.0


# 日志配置
LOG_LEVEL=INFO

# 服务端口
AI_SERVICE_PORT=8081
GRPC_PORT=50051
AI_SERVICE_ADDRESS=localhost:50051

# ============================================================
# 数据库配置
# ============================================================

# PostgreSQL 配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=luna

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================
# 上下文压缩治理配置
# ============================================================
# 是否开启 memory 槽位压缩治理
MEMORY_SLOT_COMPRESSION_ENABLED=true
# memory 槽位总 Token 上限
MEMORY_SLOT_MAX_TOKENS=12000
# 单个 memory 变量的 Token 上限
MEMORY_SLOT_SINGLE_VARIABLE_MAX_TOKENS=4000
# 统一历史背景最终上限
HISTORICAL_CONTEXT_MAX_TOKENS=3000
# 压缩回放预览最大字符数
COMPRESSION_REPLAY_PREVIEW_MAX_CHARS=400
# 是否开启压缩审计
COMPRESSION_AUDIT_ENABLED=true

# ============================================================
# 模型路径配置 (用于 Embedding 和 Rerank)
# ============================================================
# Embedding 模型路径（SentenceTransformer 格式）
# 示例: D:/AI_Models/bge-base-zh-v1.5-model
EMBEDDING_MODEL_PATH=

# Rerank 模型路径（CrossEncoder 格式）
# 示例: D:/AI_Models/bge-reranker-v2-m3-model
RERANK_MODEL_PATH=

# ============================================================
# 检索配置
# ============================================================
# 向量检索返回的 Top-K 数量
RETRIEVAL_TOP_K=5

# 重排后截取的 Top-K 数量（最终注入 Prompt 的记忆条数上限）
RERANK_TOP_K=3

# ============================================================
# Qdrant 配置
# ============================================================
# Qdrant HTTP API 地址
QDRANT_ADDRESS=http://localhost:6333

# ============================================================
# 内存守护进程配置 (memory_guardian)
# ============================================================
# Windows 计划任务名称（用于触发内存清理）
MEMORY_GUARDIAN_TASK_NAME=MemoryBoost

# 内存占用率触发阈值（百分比，达到此值时触发计划任务）
MEMORY_GUARDIAN_THRESHOLD=90.0

# 释放阈值（百分比，内存回落到此值以下后允许再次触发）
MEMORY_GUARDIAN_RELEASE=80.0

# 轮询间隔（秒）
MEMORY_GUARDIAN_INTERVAL=5

# 触发后冷却时间（秒）
MEMORY_GUARDIAN_COOLDOWN=120

# ============================================================
# MCP 工具与 Skill 执行配置
# ============================================================
# 工具执行默认超时（秒）
MCP_TOOL_TIMEOUT=30.0
# 工具执行最大重试次数
MCP_TOOL_MAX_RETRIES=2

# Skill 三阶段 Agent 最大执行步长
SKILL_MAX_EXECUTION_STEPS=30
# Skill 三阶段 Agent 最大退回次数
SKILL_MAX_FALLBACK_COUNT=2

# ============================================================
# LLM 响应模式配置
# ============================================================
# LLM 响应模式：streaming（流式） / unified（统一非流式）
# unified：后端一次性合成全量回复，前端语义切分后气泡+音频同步播放
# streaming：传统逐 Token 流式输出（兼容模式）
LLM_RESPONSE_MODE=unified

# ============================================================
# TTS 服务配置
# ============================================================
# TTS 服务启动脚本路径 (如配置，主程序启动时将自动拉起)
TTS_BAT_PATH=

# TTS API 基础地址（GPT-SoVITS 或 OpenAI-compatible TTS 服务的 HTTP 地址）
# 示例: http://127.0.0.1:8999 或 https://api.openai.com/v1
TTS_BASE_URL=http://127.0.0.1:8999

# TTS API 端点路径（GPT-SoVITS 使用 /v1/audio/speech 与 OpenAI-compatible 对齐）
TTS_ENDPOINT=/v1/audio/speech

# GPT-SoVITS 模型版本号，用于构建 "GSVI-{version}" 格式的 model 请求参数
# GPT-SoVITS 服务端通过 model.split("-")[1] 解析版本号，错误格式会导致 IndexError
# 如果使用 GPT-SoVITS v4 请保持 "v4"
TTS_MODEL_VERSION=v4

# TTS 默认模型/角色名称（例如"阿米娅"）
TTS_DEFAULT_MODEL=阿米娅

# TTS 默认音色名称（例如"阿米娅"）
TTS_DEFAULT_VOICE=阿米娅

# TTS 输出音频格式：mp3 / wav / ogg
TTS_RESPONSE_FORMAT=mp3

# TTS 语速倍率（1.0 为正常语速）
TTS_SPEED=1.0

# TTS HTTP 请求超时时间（秒）
TTS_TIMEOUT=120.0

# TTS 缓存目录（存放已生成的音频文件，支持绝对或相对路径）
# 示例: data/tts_cache 或 D:/Luna/cache/tts
TTS_CACHE_DIR=data/tts_cache

# GPT-SoVITS 服务端输出目录（可选，留空则不使用）
# 用于同步备份已生成的音频文件
# 示例: E:/modelscope/dir/GPT-SoVITS-1007-cu128/outputs
TTS_SERVICE_OUTPUTS_DIR=

# TTS 缓存文件保留时长（小时），超过此时间的缓存将被清理
TTS_CLEANUP_KEEP_HOURS=24