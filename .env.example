# Luna AI 环境变量示例
# 复制此文件为 .env 并填入实际值
# 注意：请勿在此文件中填写真实的敏感信息，仅作为配置示例

# ============================================================
# Go Runtime 配置 (backend/runtime)
# ============================================================

# HTTP 服务器配置
SERVER_PORT=8080

# 日志配置
LOG_LEVEL=INFO

# AI 服务连接
AI_SERVICE_ADDRESS=localhost:50051

# PostgreSQL 配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=luna

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================
# Python AI 服务配置 (backend/ai-service)
# ============================================================

# 服务端口
AI_SERVICE_PORT=8000
GRPC_PORT=50051

# 上下文管理
MAX_CONTEXT_TOKENS=8192
RESERVED_OUTPUT_TOKENS=2048