    "state2": {
      "skill": "技能名称，来自选中的技能信息。例如 'search'。",
      "resource": [],
      "tools": ["与 state1 不同的工具"]
    }
  },
  "execution_order": [
    "执行顺序列表。元素为 state_key，按执行先后排列。\n系统按此顺序先加载 resource 再执行 tools。"
