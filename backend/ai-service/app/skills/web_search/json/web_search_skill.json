{
  "skills": [
    {
      "name": "web_search",
      "description": "提供通过 SearXNG 搜索引擎实例执行网络搜索的工具实现。支持并发请求、自动翻页、分类筛选和语言过滤。作为 L0 级低危工具直接放行无需用户确认。",
      "version": "1.1.0",
      "enabled": true,
      "metadata": {
        "author": "Luna-AI",
        "tags": ["search", "information-retrieval", "web", "searxng"]
      },
      "prompts": [
        {
          "phase": "execution",
          "content_path": "app/skills/web_search/prompts/search_tool_prompt.j2",
          "variables": [
            {"name": "system_context", "description": "系统上下文", "required": false},
            {"name": "search_goal", "description": "搜索目标", "required": false},
            {"name": "previous_query", "description": "上一轮查询词", "required": false},
            {"name": "previous_categories", "description": "上一轮分类", "required": false},
            {"name": "previous_time_range", "description": "上一轮时间范围", "required": false},
            {"name": "previous_results_summary", "description": "上一轮结果摘要", "required": false},
            {"name": "attempted_queries", "description": "已尝试的查询词列表", "required": false},
            {"name": "gathered_information", "description": "已获取的关键信息", "required": false},
            {"name": "need_continue_search", "description": "是否需要继续搜索", "required": false},
            {"name": "continue_reason", "description": "继续原因", "required": false},
            {"name": "this_round_goal", "description": "本轮搜索目标", "required": false},
            {"name": "this_query", "description": "本轮查询词", "required": false},
            {"name": "category_adjust_reason", "description": "分类调整理由", "required": false},
            {"name": "time_range_adjust_reason", "description": "时间范围调整理由", "required": false},
            {"name": "user_input", "description": "用户原始输入", "required": true}
          ]
        }
      ],
      "resources": [
        {
          "name": "web_search_skill_design",
          "resource_type": "file",
          "uri": "app/skills/web_search/resource/web_search_skill_design.md",
          "description": "Web Search Skill 通用搜索建议和推荐最佳实践",
          "mime_type": "text/markdown",
          "auto_load": true
        }
      ],
      "tools": [
        {
          "name": "web_search",
          "description": "通过 SearXNG 执行网络搜索",
          "memory_schema": {
            "type": "object",
            "properties": {
              "search_goal": { "type": "string", "description": "本次总的搜索目的" },
              "previous_query": { "type": "string", "description": "刚尝试搜索的关键词" },
              "previous_categories": { "type": "string", "description": "上一轮使用的分类" },
              "previous_time_range": { "type": "string", "description": "上一轮使用的时间范围" },
              "previous_results_summary": { "type": "string", "description": "上一轮搜索得到的核心结果或没找到的原因" },
              "attempted_queries": { "type": "string", "description": "历史已经尝试过的所有搜索词列表，格式如 ['词1', '词2']" },
              "gathered_information": { "type": "string", "description": "至今累积搜集到的有效关键信息" },
              "need_continue_search": { "type": "string", "enum": ["是", "否"] },
              "continue_reason": { "type": "string", "description": "为什么要继续搜索/改变策略的原因" },
              "this_round_goal": { "type": "string", "description": "下一轮想要搜什么" },
              "this_query": { "type": "string", "description": "下一轮建议使用的搜索词" },
              "category_adjust_reason": { "type": "string" },
              "time_range_adjust_reason": { "type": "string" }
            }
          },
          "parameters_schema": {
            "type": "object",
            "properties": {
              "query": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "minItems": 1,
                  "maxItems": 50,
                  "description": "该并发请求要同时使用的多个搜索词。例如：['2024年诺贝尔奖获得者', 'Nobel Prize winners 2024']。"
                },
                "minItems": 3,
                "maxItems": 3,
                "description": "搜索查询关键词外层数组。必填。外层数组长度必须与'并发请求数量'配置一致，其中每个内层数组包含该并发请求要同时使用的多个搜索词。"
              },
              "categories": {
                "type": "string",
                "description": "搜索分类筛选，可选。多个分类用逗号分隔。可选值：general, news, images, videos, files, music, it, science, social media。默认：general。例如：'general,news'。",
                "default": "general"
              },
              "language": {
                "type": "string",
                "description": "搜索语言过滤，可选。强烈建议根据搜索词的语言指定。中文搜索词请使用 'zh-CN'，英文搜索词请使用 'en'。留空则由 SearXNG 实例默认配置决定，可能导致中文查询返回空结果。",
                "default": ""
              },
              "time_range": {
                "type": "string",
                "enum": ["", "day", "month", "year"],
                "default": "",
                "description": "时间范围过滤"
              }
            },
            "required": ["query"]
          },
          "risk_level": "L0",
          "enabled": true,
          "tags": ["search", "web", "information"],
          "category": "utility",
          "use_case_examples": [
            "搜索今天的新闻",
            "查找 Python 3.12 的新特性",
            "搜索如何使用 Docker 部署 SearXNG"
          ],
          "core_purpose": "通过本地或局域网部署的 SearXNG 实例获取网络信息，满足本地优先和隐私保护需求。",
          "final_deliverable": "包含来源 URL 的搜索结果汇总和整理",
          "source": "local",
          "module_path": "app.skills.web_search.search_tool",
          "tool_config": {
            "base_url": "http://127.0.0.1:8080",
            "timeout": 15.0,
            "concurrent_requests": 3,
            "results_per_request": 10,
            "max_url_fetch_length": 8192,
            "safe_search_level": 1
          }
        }
      ],
      "servers": []
    }
  ]
}
